# Public hostname pointed to this Ubuntu server (A/AAAA record).
API_DOMAIN=api.example.com

# PostgreSQL
POSTGRES_DB=paytrack
POSTGRES_USER=paytrack
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Application security
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=180

# Google OAuth client id used by the mobile app/backend validation.
GOOGLE_CLIENT_ID=

# Local non-Docker development defaults (optional).
DB_URL=jdbc:postgresql://localhost:5432/paytrack
DB_USERNAME=paytrack
DB_PASSWORD=paytrack
PORT=8080
