{$API_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  handle_path /privacy* {
    root * /srv/site/privacy
    file_server
  }

  handle_path /support* {
    root * /srv/site/support
    file_server
  }

  handle_path /delete-account* {
    root * /srv/site/delete-account
    file_server
  }

  handle {
    reverse_proxy backend:8080
  }

  log {
    output stdout
    format console
  }
}
